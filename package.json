{
  "name": "app-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:crh": "TENANT_ID=crh npm run build",
    "build:generic": "TENANT_ID=generic npm run build",
    "build:static": "STATIC_EXPORT=true npm run build && node scripts/inline-css.js && npx tsx scripts/export-engine-config.ts",
    "export": "npm run build:static",
    "static": "npm run build:static",
    "start": "next start",
    "lint": "next lint",
    "observer:sync": "npx tsx scripts/sync-project-observer.ts"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8",
    "@netlify/plugin-nextjs": "^5.15.11"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
