# 本番静的ホスト用ベースパス（任意）
# BASE_PATH=/crh/request-content-generation-tool
# NEXT_PUBLIC_BASE_PATH=/crh/request-content-generation-tool

# Project Observer — Backlog連携
BACKLOG_SPACE=https://your-space.backlog.jp
BACKLOG_API_KEY=
BACKLOG_PROJECT_IDS=PROJECT_KEY_1,PROJECT_KEY_2
BACKLOG_INTERNAL_EMAIL_DOMAIN=creativehope.jp

# true: モックデータを強制
# BACKLOG_USE_MOCK=true

# true: data/snapshot.json を優先（本番ビルド推奨）
# BACKLOG_USE_SNAPSHOT=true

# 開発で snapshot がある場合も Backlog API を直接叩く（レート制限に注意）
# BACKLOG_USE_LIVE_IN_DEV=true
